# Database configuration
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres_password
# Importante: Este é o nome correto que o Rails espera em ambiente de produção
POSTGRES_DATABASE=chatwoot_production
POSTGRES_PORT=5432
RAILS_ENV=production
NODE_ENV=production

# Redis configuration - configuração sem senha para evitar problemas de autenticação
REDIS_URL=redis://redis:6379

# Rails configuration
# Importante: Gere um valor seguro usando o comando 'rails secret'
SECRET_KEY_BASE=ieuag3XCAF20LSHbyfG9sQ7vJPOBVh4ENrdkxplm5cMZYIz1R8TnK6tqWDjowU
INSTALLATION_ENV=docker
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true

# URLs and Hosts - Atualize com seu domínio real
FRONTEND_URL=https://chatwoot.rotadoscelulares.com
BACKEND_URL=https://chatwoot.rotadoscelulares.com
APP_BASE_URL=https://chatwoot.rotadoscelulares.com
FORCE_SSL=true

# Configurações de aplicação
ENABLE_ACCOUNT_SIGNUP=true
ACTIVE_STORAGE_SERVICE=local

# Configurações adicionais de recursos
DEFAULT_LOCALE=pt_BR

# Após a instalação inicial, execute os seguintes comandos no container Rails:
# bundle exec rails db:create db:migrate db:seed
# Para criar um administrador:
# bundle exec rails c
# account = Account.create!(name: "Sua Empresa")
# user = User.new(email: "admin@example.com", password: "senha_segura", name: "Admin")
# user.skip_confirmation!
# user.save!
